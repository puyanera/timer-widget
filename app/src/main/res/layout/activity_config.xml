<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Timer Widget"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a duration for this widget"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="28dp"/>

        <Button android:id="@+id/btn_1min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="1 Minute" android:layout_marginBottom="10dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <Button android:id="@+id/btn_2min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="2 Minutes" android:layout_marginBottom="10dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <Button android:id="@+id/btn_5min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="5 Minutes" android:layout_marginBottom="10dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <Button android:id="@+id/btn_10min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="10 Minutes" android:layout_marginBottom="10dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <Button android:id="@+id/btn_15min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="15 Minutes" android:layout_marginBottom="10dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <Button android:id="@+id/btn_20min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="20 Minutes" android:layout_marginBottom="10dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <Button android:id="@+id/btn_30min"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="30 Minutes" android:layout_marginBottom="24dp"
            android:backgroundTint="#FF6B35" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#DDDDDD" android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom duration"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/custom_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter minutes (e.g. 45)"
            android:inputType="number"
            android:layout_marginBottom="10dp"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <Button android:id="@+id/btn_save_custom"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Use Custom Duration"
            android:backgroundTint="#444444" android:textColor="#FFFFFF"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>
